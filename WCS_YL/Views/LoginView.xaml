<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Name="Login_View" Width="500" Height="450" Icon="../资源/hc.ico" Title="仓储控制系统(WCS系统) - WCSAPP - based on v2.0.0.0" WindowStartupLocation="CenterScreen" WindowStyle="None" mc:Ignorable="d">
  <Window.Resources>
    <local:ObjectConvert x:Key="ObjectConvert" xmlns:local="clr-namespace:GZ.Projects.WCSAPP" />
    <Style x:Key="MaterialDesignRaisedDarkButton" TargetType="{x:Type ButtonBase}">
      <Setter Property="Background" Value="#FF00796B" />
      <Setter Property="BorderBrush" Value="#FF00796B" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </Window.Resources>
  <Grid Background="#EBF5FF">
    <Grid>
      <!--布局-->
      <Grid.RowDefinitions>
        <RowDefinition Height="1*" />
        <RowDefinition Height="3*" />
        <RowDefinition Height="1*" />
      </Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="1.6*" />
        </Grid.ColumnDefinitions>
        <Image Margin="5,5,5,5" Source="../资源/log.jpg" Stretch="Fill" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" />
        <Label HorizontalAlignment="left" VerticalAlignment="Center" FontSize="24" FontWeight="Bold" Grid.Column="1" Grid.Row="0">
          仓库控制系统(WCS系统)
        </Label>
        <WrapPanel Grid.Column="1" Grid.Row="1">
          <Label Content="-" HorizontalAlignment="left" VerticalAlignment="Center" FontSize="24" FontWeight="Bold" />
          <Label Content="{Binding Tag.ProjName}" HorizontalAlignment="left" VerticalAlignment="Center" FontSize="24" FontWeight="Bold" />
          <Label Content="-" HorizontalAlignment="left" VerticalAlignment="Center" FontSize="24" FontWeight="Bold" />
        </WrapPanel>
      </Grid>
      <!--输入内容-->
      <Grid Grid.Row="1">
        <!--布局-->
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition />
          <RowDefinition />
          <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.ColumnSpan="2" Grid.Row="0" Grid.RowSpan="2">
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="3*" />
          </Grid.ColumnDefinitions>
          <!--当前设备编号-->
          <Label Width="170" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25" Grid.Column="0" Grid.Row="0">
            当前设备编号：
          </Label>
          <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="25" Text="{Binding Tag.UI.登录.TXT_DeviceNo}" Grid.Column="1" Grid.Row="0" />
          <!--当前设备名称-->
          <Label Width="170" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25" Grid.Column="0" Grid.Row="1">
            当前设备名称：
          </Label>
          <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="25" Text="{Binding Tag.UI.登录.TXT_DeviceName}" Grid.Column="1" Grid.Row="1" />
        </Grid>
        <!--用户名-->
        <Label Width="70" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="25" Grid.Column="0" Grid.Row="2">
          账户：
        </Label>
        <TextBox x:Name="txtUserName" Width="250" Margin="10,10,10,10" HorizontalAlignment="Center" VerticalContentAlignment="Center" FontSize="25" MaxLength="20" TextAlignment="Center" Grid.Column="1" Grid.Row="2" />
        <!--密码-->
        <Label Width="70" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="25" Grid.Column="0" Grid.Row="3">
          密码：
        </Label>
        <PasswordBox x:Name="txtPassword" Width="250" Margin="10,10,10,10" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="25" MaxLength="20" Grid.Column="1" Grid.Row="3" />
      </Grid>
      <!--操作按钮-->
      <Grid Grid.Row="2">
        <!--布局-->
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <!--登录按钮-->
        <Button x:Name="btnOK" Command="{Binding LoginCommand}" Width="125" Height="40" Style="{StaticResource MaterialDesignRaisedDarkButton}" Grid.Column="0">
          登录
          <Button.CommandParameter><MultiBinding Converter="{ StaticResource ResourceKey=ObjectConvert}"><Binding ElementName="txtUserName" /><Binding ElementName="txtPassword" /><Binding ElementName="Login_View" /></MultiBinding></Button.CommandParameter></Button>
        <!--重置按钮
          <Button x:Name="btnClear"
                  Command="{Binding ClearCommand}"
                  Width="100"
                  Height="50"
                  CommandParameter="{Binding ElementName=txtPassword}"
                  Style="{StaticResource MaterialDesignRaisedDarkButton}"
                  Grid.Column="1">
            重置
          </Button>-->
        <Button x:Name="btnClose" Command="{Binding CloseCommand}" Width="125" Height="40" Style="{StaticResource MaterialDesignRaisedDarkButton}" Grid.Column="2">
          关闭
        </Button>
      </Grid>
    </Grid>
  </Grid>
</Window>