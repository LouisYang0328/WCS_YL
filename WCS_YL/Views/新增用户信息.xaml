<Window x:Class="GZ.Projects.WCS_Template.新增用户信息" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GZ.Projects.WCS_Template" Name="Login_Permissions" Width="640" Height="400">
  <Window.Resources>
    <local:ObjectConvert x:Key="ObjectConvert" xmlns:local="clr-namespace:GZ.Projects.WCS" />
    <Style x:Key="MaterialDesignRaisedDarkButton" TargetType="{x:Type ButtonBase}">
      <Setter Property="Background" Value="#FF00796B" />
      <Setter Property="BorderBrush" Value="#FF00796B" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </Window.Resources>
  <Grid Background="#EBF5FF">
    <Grid>
      <!--  布局  -->
      <Grid.RowDefinitions>
        <RowDefinition Height="1*" />
        <RowDefinition Height="2*" />
        <RowDefinition Height="1*" />
        <RowDefinition Height="0.8*" />
      </Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <Grid.RowDefinitions>
          <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25" Text="{Binding Tag.用户权限.TXT_Total}" Grid.Column="1" Grid.Row="1" />
      </Grid>
      <!--  输入内容  -->
      <Grid Grid.Row="1">
        <!--  布局  -->
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        <!--  密码  -->
        <Label Width="70" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="25" Grid.Column="0" Grid.Row="1">
          密码：
        </Label>
        <TextBox Margin="26,7,25,3" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="LightGreen" BorderThickness="1" FontSize="20" Text="{Binding Tag.用户权限.TXT_PassWord}" Grid.Column="1" Grid.Row="1" />
        <Label Width="70" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="25" Grid.Column="0" Grid.Row="0">
          用户：
        </Label>
        <TextBox Margin="26,7,25,3" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="LightGreen" BorderThickness="1" FontSize="20" IsReadOnly="{Binding Tag.用户权限.IsReadOnly}" Text="{Binding Tag.用户权限.TXT_Name}" Grid.Column="1" Grid.Row="0" />
      </Grid>
      <!--  操作按钮  -->
      <Grid Grid.Row="2">
        <!--  布局  -->
        <Grid.RowDefinitions>
          <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="3*" />
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="3*" />
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        <CheckBox Content="自定义样式" IsChecked="{Binding Tag.用户权限.Bool_Button, Mode=TwoWay}" IsEnabled="{Binding Tag.用户权限.IsEnabled, Mode=TwoWay}" RenderTransformOrigin="1.277,0.447" Grid.Column="2" Grid.Row="0">
          <CheckBox.Template>
            <ControlTemplate TargetType="CheckBox">
              <Grid>
                <Border x:Name="Border" Width="30" Height="30" Background="LightGray" />
                <!--<TextBlock Text="✓" Visibility="Collapsed" x:Name="CheckMark"/>-->
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <!--<Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>-->
                  <Setter Property="Background" TargetName="Border" Value="Green" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </CheckBox.Template>
        </CheckBox>
        <TextBlock Margin="5" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="18" Text="是否允许操作按钮" Grid.Column="3" Grid.Row="0" />
      </Grid>
      <Grid Grid.Row="3">
        <!--  布局  -->
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <!--  登录按钮  -->
        <Button x:Name="btnOK" Command="{Binding SaveCommand}" Width="125" Height="40" Style="{StaticResource MaterialDesignRaisedDarkButton}" Grid.Column="0">
          保存
          <Button.CommandParameter><MultiBinding Converter="{StaticResource ResourceKey=ObjectConvert}"><Binding ElementName="Login_Permissions" /></MultiBinding></Button.CommandParameter></Button>
        <!--重置按钮
          <Button x:Name="btnClear"
                  Command="{Binding ClearCommand}"
                  Width="100"
                  Height="50"
                  CommandParameter="{Binding ElementName=txtPassword}"
                  Style="{StaticResource MaterialDesignRaisedDarkButton}"
                  Grid.Column="1">
            重置
          </Button>-->
        <Button x:Name="btnClose" Command="{Binding ClosePermissions}" Width="125" Height="40" Style="{StaticResource MaterialDesignRaisedDarkButton}" Grid.Column="2">
          关闭
          <Button.CommandParameter><MultiBinding Converter="{StaticResource ResourceKey=ObjectConvert}"><Binding ElementName="Login_Permissions" /></MultiBinding></Button.CommandParameter></Button>
      </Grid>
    </Grid>
  </Grid>
</Window>