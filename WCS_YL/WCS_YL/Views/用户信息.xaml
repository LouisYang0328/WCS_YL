<Window x:Class="GZ.Projects.WCS.用户信息" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GZ.Projects.WCS" Width="1750" Height="750">
  <Window.Resources>
    <!-- <local:PasswordVisibilityConverter x:Key="PasswordConverter" /> -->
    <!--  文本标签Label  -->
    <Style x:Key="CurrentLabel" TargetType="{x:Type Label}">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <!--  下拉框  -->
    <Style x:Key="CurrentComboBox" TargetType="{x:Type ComboBox}">
      <Setter Property="MinWidth" Value="100" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="IsEditable" Value="True" />
      <Setter Property="IsTextSearchEnabled" Value="True" />
      <Setter Property="FontSize" Value="20" />
    </Style>
    <!--  按钮  -->
    <Style x:Key="CurrentButton" TargetType="{x:Type Button}">
      <Setter Property="Background" Value="#FF00796B" />
      <Setter Property="BorderBrush" Value="#FF00796B" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="20" />
    </Style>
    <!--  文本框  -->
    <Style x:Key="CurrentTextBox" TargetType="{x:Type TextBox}">
      <Setter Property="MinWidth" Value="100" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!--  文本标签Label  -->
    <Style x:Key="CurrentDatePicker" TargetType="{x:Type DatePicker}">
      <Setter Property="MinWidth" Value="150" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="18" />
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="0.7*" />
      <RowDefinition Height="0.6*" />
      <RowDefinition Height="7.5*" />
      <RowDefinition Height="0.8*" />
    </Grid.RowDefinitions>
    <Border BorderBrush="Gray" BorderThickness="1" Grid.Row="0">
      <Grid Background="#FFD0CCCC" Grid.ColumnSpan="2" Grid.Row="0">
        <TextBlock Margin="10" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="30" FontWeight="Bold">
          系统管理/用户信息
        </TextBlock>
      </Grid>
    </Border>
    <!--  搜索条件  -->
    <Grid Background="LightGray" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.8*" />
        <ColumnDefinition />
        <ColumnDefinition Width="0.6*" />
        <ColumnDefinition />
        <ColumnDefinition Width="0.6*" />
        <ColumnDefinition />
        <ColumnDefinition Width="0.6*" />
        <ColumnDefinition />
        <ColumnDefinition />
        <ColumnDefinition />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <!--<TextBlock Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="20" Text="设备任务号" Grid.Column="0" Grid.Row="0" />
    <TextBox Margin="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="LightGreen" BorderThickness="1" FontSize="20" Text="{Binding Tag.用户权限.TXT_DeviceTaskNo}" Grid.Column="1" Grid.Row="0" />
    <TextBlock Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="20" Text="设备编号" Grid.Column="2" Grid.Row="0" />
    <ComboBox Margin="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="LightGreen" BorderThickness="1" DisplayMemberPath="DictValue" FontSize="20" ItemsSource="{Binding Tag.用户权限.List_DeviceNo}" SelectedValue="{Binding Tag.用户权限.TXT_DeviceNo}" SelectedValuePath="DictName" Grid.Column="3" Grid.Row="0" />
    <TextBlock Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="20" Text="开始时间" Grid.Column="4" Grid.Row="0" />
    <DatePicker Margin="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="White" BorderBrush="LightGreen" BorderThickness="1" FontSize="20" SelectedDate="{Binding Tag.用户权限.TXT_StartTime}" Style="{StaticResource CurrentDatePicker}" Grid.Column="5" Grid.Row="0" />
    <TextBlock Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="20" Text="结束时间" Grid.Column="6" Grid.Row="0" />
    <DatePicker Margin="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="White" BorderBrush="LightGreen" BorderThickness="1" FontSize="20" SelectedDate="{Binding Tag.用户权限.TXT_EndTime}" Style="{StaticResource CurrentDatePicker}" Grid.Column="7" Grid.Row="0" />-->
      <Button Content="查询" Command="{Binding btn_UserPermissions_Select}" Margin="10,3" FontSize="20" Style="{StaticResource CurrentButton}" Grid.Column="7" Grid.Row="0" />
      <Button Content="新增" Command="{Binding btn_UserPermissions_Add}" Margin="10,3" FontSize="20" Style="{StaticResource CurrentButton}" Grid.Column="8" Grid.Row="0" />
      <Button Content="修改" Command="{Binding btn_UserPermissions_Update}" Margin="10,3" CommandParameter="{Binding ElementName=dgMission}" FontSize="20" Style="{StaticResource CurrentButton}" Grid.Column="9" Grid.Row="0" />
      <Button Content="删除" Command="{Binding btn_UserPermissions_Delete}" Margin="10,3" CommandParameter="{Binding ElementName=dgMission}" FontSize="20" Style="{StaticResource CurrentButton}" Grid.Column="10" Grid.Row="0" />
      <!-- <Button Content="导出"
            Command="{Binding btn_UserPermissions_Inport}"
            Margin="10,3"
            FontSize="20"
            Style="{StaticResource CurrentButton}"
            Grid.Column="9"
            Grid.Row="0" />-->
    </Grid>
    <!--  数据展示列表  -->
    <Grid Margin="5" Grid.Row="2">
      <!--  数据表区：数据表  -->
      <DataGrid x:Name="dgMission" Margin="0,0,0.4,0.4" HorizontalContentAlignment="Center" AlternationCount="2" AutoGenerateColumns="False" Background="#EBF5FF" CanUserAddRows="False" CanUserSortColumns="True" FontSize="20" ItemsSource="{Binding Tag.用户权限.List_UserPermissions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="5" SelectionUnit="FullRow" Grid.ColumnSpan="2" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
        <DataGrid.ColumnHeaderStyle>
          <Style TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="2" />
          </Style>
        </DataGrid.ColumnHeaderStyle>
        <DataGrid.RowStyle>
          <Style TargetType="{x:Type DataGridRow}">
            <Style.Triggers>
              <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                <Setter Property="Background" Value="#F0FFFF" />
                <Setter Property="Height" Value="30" />
                <Setter Property="FontSize" Value="18" />
              </Trigger>
              <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                <Setter Property="Background" Value="White" />
                <Setter Property="Height" Value="30" />
                <Setter Property="FontSize" Value="18" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </DataGrid.RowStyle>
        <!--  数据表：列  -->
        <DataGrid.Columns>
          <DataGridTextColumn Width="200" Binding="{Binding DictName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="用户名" IsReadOnly="True" />
          <DataGridTextColumn Width="200" Binding="{Binding DictValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="密码" IsReadOnly="True">
            <!--<DataGridTextColumn.Binding>
              <MultiBinding Converter="{StaticResource PasswordConverter}">
                <Binding Path="DictValue" />
                <Binding Path="DictStr" />
              </MultiBinding>
            </DataGridTextColumn.Binding>-->
          </DataGridTextColumn>
          <DataGridTextColumn Width="150" Binding="{Binding DictStr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="权限" IsReadOnly="True" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
    <Grid Background="LightGray" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.8*" />
        <ColumnDefinition />
        <ColumnDefinition Width="0.6*" />
        <ColumnDefinition />
        <ColumnDefinition Width="0.6*" />
        <ColumnDefinition />
        <ColumnDefinition Width="0.6*" />
        <ColumnDefinition />
        <ColumnDefinition />
        <ColumnDefinition />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <!--<TextBlock Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="20" Text="设备任务号" Grid.Column="0" Grid.Row="0" />
    <TextBox Margin="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="LightGreen" BorderThickness="1" FontSize="20" Text="{Binding Tag.用户权限.TXT_DeviceTaskNo}" Grid.Column="1" Grid.Row="0" />
    <TextBlock Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="20" Text="设备编号" Grid.Column="2" Grid.Row="0" />
    <ComboBox Margin="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="LightGreen" BorderThickness="1" DisplayMemberPath="DictValue" FontSize="20" ItemsSource="{Binding Tag.用户权限.List_DeviceNo}" SelectedValue="{Binding Tag.用户权限.TXT_DeviceNo}" SelectedValuePath="DictName" Grid.Column="3" Grid.Row="0" />
    <TextBlock Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="20" Text="开始时间" Grid.Column="4" Grid.Row="0" />
    <DatePicker Margin="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="White" BorderBrush="LightGreen" BorderThickness="1" FontSize="20" SelectedDate="{Binding Tag.用户权限.TXT_StartTime}" Style="{StaticResource CurrentDatePicker}" Grid.Column="5" Grid.Row="0" />
    <TextBlock Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="20" Text="结束时间" Grid.Column="6" Grid.Row="0" />
    <DatePicker Margin="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="White" BorderBrush="LightGreen" BorderThickness="1" FontSize="20" SelectedDate="{Binding Tag.用户权限.TXT_EndTime}" Style="{StaticResource CurrentDatePicker}" Grid.Column="7" Grid.Row="0" />-->
      <Button Content="查询" Command="{Binding btn_UserPermissions_Select}" Margin="10,3" FontSize="20" Style="{StaticResource CurrentButton}" Grid.Column="7" Grid.Row="0" />
      <Button Content="新增" Command="{Binding btn_UserPermissions_Add}" Margin="10,3" FontSize="20" Style="{StaticResource CurrentButton}" Visibility="{Binding Tag.用户权限.Button}" Grid.Column="8" Grid.Row="0" />
      <Button Content="修改" Command="{Binding btn_UserPermissions_Update}" Margin="10,3" CommandParameter="{Binding ElementName=dgMission}" FontSize="20" Style="{StaticResource CurrentButton}" Grid.Column="9" Grid.Row="0" />
      <Button Content="删除" Command="{Binding btn_UserPermissions_Delete}" Margin="10,3" CommandParameter="{Binding ElementName=dgMission}" FontSize="20" Style="{StaticResource CurrentButton}" Visibility="{Binding Tag.用户权限.Button}" Grid.Column="10" Grid.Row="0" />
      <!-- <Button Content="导出"
            Command="{Binding btn_UserPermissions_Inport}"
            Margin="10,3"
            FontSize="20"
            Style="{StaticResource CurrentButton}"
            Grid.Column="9"
            Grid.Row="0" />-->
    </Grid>
    <!--  页码信息以及翻页功能  -->
    <Grid Margin="1" Background="#EBF5FF" Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="0.5*" />
        <ColumnDefinition Width="0.5*" />
        <ColumnDefinition Width="0.5*" />
        <ColumnDefinition Width="0.5*" />
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0">
        <Grid>
          <Label Content="{Binding Tag.用户权限.Page_Message}" HorizontalAlignment="Left" Style="{StaticResource CurrentLabel}" />
        </Grid>
      </Grid>
      <Grid Grid.Column="2">
        <Button Command="{Binding btn_UserPermissions_First}" Margin="10" FontSize="20" Style="{StaticResource CurrentButton}">
          首页
        </Button>
      </Grid>
      <Grid Grid.Column="3">
        <Button Command="{Binding btn_UserPermissions_Previous}" Margin="10" FontSize="20" Style="{StaticResource CurrentButton}">
          上一页
        </Button>
      </Grid>
      <Grid Grid.Column="4">
        <Button Command="{Binding btn_UserPermissions_Next}" Margin="10" FontSize="20" Style="{StaticResource CurrentButton}">
          下一页
        </Button>
      </Grid>
      <Grid Grid.Column="5">
        <Button Command="{Binding btn_UserPermissions_Last}" Margin="10" FontSize="20" Style="{StaticResource CurrentButton}">
          尾页
        </Button>
      </Grid>
    </Grid>
  </Grid>
</Window>