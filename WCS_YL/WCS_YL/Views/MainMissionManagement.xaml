<Window x:Class="GZ.Projects.WCS.MainMissionManagement" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:GZ.Projects.WCS" d:DesignHeight="750" d:DesignWidth="1750" mc:Ignorable="d">
  <Window.Resources>
    <local:TaskState_Convert x:Key="TaskState_Convert" xmlns:local="clr-namespace:GZ.Projects.WCS" />
    <local:TaskType_Convert x:Key="TaskType_Convert" xmlns:local="clr-namespace:GZ.Projects.WCS" />
    <local:Order_type_Convert x:Key="Order_type_Convert" xmlns:local="clr-namespace:GZ.Projects.WCS" />
    <local:station_Name_Convert x:Key="station_Name_Convert" xmlns:local="clr-namespace:GZ.Projects.WCS" />
    <!--  文本标签Label  -->
    <Style x:Key="CurrentLabel" TargetType="{x:Type Label}">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <!--  下拉框  -->
    <Style x:Key="CurrentComboBox" TargetType="{x:Type ComboBox}">
      <Setter Property="MinWidth" Value="100" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="IsEditable" Value="True" />
      <Setter Property="IsTextSearchEnabled" Value="True" />
      <Setter Property="FontSize" Value="20" />
    </Style>
    <!--  按钮  -->
    <Style x:Key="CurrentButton" TargetType="{x:Type Button}">
      <Setter Property="Background" Value="#FF00796B" />
      <Setter Property="BorderBrush" Value="#FF00796B" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="20" />
    </Style>
    <!--  文本框  -->
    <Style x:Key="CurrentTextBox" TargetType="{x:Type TextBox}">
      <Setter Property="MinWidth" Value="100" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!--  文本标签Label  -->
    <Style x:Key="CurrentDatePicker" TargetType="{x:Type DatePicker}">
      <Setter Property="MinWidth" Value="150" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="18" />
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="0.8*" />
      <RowDefinition Height="0*" />
      <RowDefinition Height="1.3*" />
      <RowDefinition Height="7*" />
      <RowDefinition Height="1*" />
    </Grid.RowDefinitions>
    <Border BorderBrush="Gray" BorderThickness="1" Grid.Row="0">
      <Grid Background="#FFD0CCCC" Grid.ColumnSpan="2" Grid.Row="0">
        <TextBlock Margin="10" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="30" FontWeight="Bold">
          任务管理/主任务管理
        </TextBlock>
      </Grid>
    </Border>
    <!--  数据展示列表  -->
    <Grid Margin="3" Grid.Row="3">
      <!--  数据表区：数据表  -->
      <DataGrid x:Name="dgMission" Margin="0,0,0.4,0.4" HorizontalContentAlignment="Center" AlternationCount="2" AutoGenerateColumns="False" Background="#EBF5FF" CanUserAddRows="False" CanUserSortColumns="True" FontSize="20" ItemsSource="{Binding Tag.任务管理.主任务管理.List_MainMission , Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="5" SelectionUnit="FullRow" Grid.ColumnSpan="2" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
        <DataGrid.ColumnHeaderStyle>
          <Style TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="2" />
          </Style>
        </DataGrid.ColumnHeaderStyle>
        <DataGrid.RowStyle>
          <Style TargetType="{x:Type DataGridRow}">
            <Style.Triggers>
              <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                <Setter Property="Background" Value="#F0FFFF" />
                <Setter Property="Height" Value="30" />
                <Setter Property="FontSize" Value="18" />
              </Trigger>
              <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                <Setter Property="Background" Value="White" />
                <Setter Property="Height" Value="30" />
                <Setter Property="FontSize" Value="18" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </DataGrid.RowStyle>
        <!--  数据表：列  -->
        <DataGrid.Columns>
          <DataGridTextColumn Width="200" Binding="{Binding material_name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="物料名称" IsReadOnly="True" />
          <DataGridTextColumn Width="200" Binding="{Binding MissionState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource TaskState_Convert}}" Header="任务执行状态" IsReadOnly="True" />
          <DataGridTextColumn Width="200" Binding="{Binding task_type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource TaskType_Convert}}" Header="任务类型" IsReadOnly="True" />
          <DataGridTextColumn Width="200" Binding="{Binding task_no, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="任务编号" IsReadOnly="True" />
          <DataGridTextColumn Width="120" Binding="{Binding tray_code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="托盘号" IsReadOnly="True" />
          <DataGridTextColumn Width="100" Binding="{Binding tunnel_no, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="巷道编码" IsReadOnly="True" />
          <DataGridTextColumn Width="200" Binding="{Binding start_position, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource station_Name_Convert}}" Header="起始站台" IsReadOnly="True" />
          <DataGridTextColumn Width="200" Binding="{Binding end_position, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource station_Name_Convert}}" Header="结束站台" IsReadOnly="True" />
          <DataGridTextColumn Width="200" Binding="{Binding InteStationNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource station_Name_Convert}}" Header="交互站台" IsReadOnly="True" />
          <DataGridTextColumn Width="200" Binding="{Binding MissionStartTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat='yyyy-MM-dd HH:mm:ss'}" Header="任务开始时间" IsReadOnly="True" />
          <DataGridTextColumn Width="200" Binding="{Binding MissionEndTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat='yyyy-MM-dd HH:mm:ss'}" Header="任务结束时间" IsReadOnly="True" />
          <DataGridTextColumn Width="200" Binding="{Binding CreateTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat='yyyy-MM-dd HH:mm:ss'}" Header="任务创建时间" IsReadOnly="True" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
    <!--  搜索条件  -->
    <Grid Background="LightGray" Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.8*" />
        <ColumnDefinition />
        <ColumnDefinition Width="0.8*" />
        <ColumnDefinition />
        <ColumnDefinition Width="0.7*" />
        <ColumnDefinition />
        <ColumnDefinition Width="0.7*" />
        <ColumnDefinition />
        <ColumnDefinition />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <TextBlock Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="20" Text="任务执行状态" Grid.Column="2" Grid.Row="0" />
      <ComboBox Margin="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="LightGreen" BorderThickness="1" DisplayMemberPath="DictValue" FontSize="20" ItemsSource="{Binding Tag.任务管理.主任务管理.List_MissionState}" SelectedValue="{Binding Tag.任务管理.主任务管理.TXT_MissionState}" SelectedValuePath="DictName" Grid.Column="3" Grid.Row="0" />
      <TextBlock Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="20" Text="任务编号" Grid.Column="0" Grid.Row="0" />
      <TextBox Margin="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="LightGreen" BorderThickness="1" FontSize="20" Text="{Binding Tag.任务管理.主任务管理.TXT_task_no}" Grid.Column="1" Grid.Row="0" />
      <TextBlock Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="20" Text="任务类型" Grid.Column="4" Grid.Row="0" />
      <ComboBox Margin="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="LightGreen" BorderThickness="1" DisplayMemberPath="DictValue" FontSize="20" ItemsSource="{Binding Tag.任务管理.主任务管理.List_task_type}" SelectedValue="{Binding Tag.任务管理.主任务管理.TXT_task_type}" SelectedValuePath="DictName" Grid.Column="5" Grid.Row="0" />
      <TextBlock Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="20" Text="巷道编码" Grid.Column="6" Grid.Row="0" />
      <ComboBox Margin="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="LightGreen" BorderThickness="1" DisplayMemberPath="DictValue" FontSize="20" ItemsSource="{Binding Tag.任务管理.主任务管理.List_tunnel_no}" SelectedValue="{Binding Tag.任务管理.主任务管理.TXT_tunnel_no}" SelectedValuePath="DictName" Grid.Column="7" Grid.Row="0" />
      <TextBlock Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="20" Text="任务起始时间" Grid.Column="0" Grid.Row="1" />
      <DatePicker Margin="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="White" BorderBrush="LightGreen" BorderThickness="1" FontSize="20" SelectedDate="{Binding Tag.任务管理.主任务管理.TXT_StartTime}" Style="{StaticResource CurrentDatePicker}" Grid.Column="1" Grid.Row="1" />
      <TextBlock Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="20" Text="任务结束时间" Grid.Column="2" Grid.Row="1" />
      <DatePicker Margin="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="White" BorderBrush="LightGreen" BorderThickness="1" FontSize="20" SelectedDate="{Binding Tag.任务管理.主任务管理.TXT_EndTime}" Style="{StaticResource CurrentDatePicker}" Grid.Column="3" Grid.Row="1" />
      <TextBlock Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="20" Text="托盘编号" Grid.Column="4" Grid.Row="1" />
      <TextBox Margin="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="LightGreen" BorderThickness="1" FontSize="20" Text="{Binding Tag.任务管理.主任务管理.TXT_TrayCode}" Grid.Column="5" Grid.Row="1" />
      <Button Content="查询" Command="{Binding btn_MainMission_Select}" Margin="10,3" FontSize="20" Style="{StaticResource CurrentButton}" Grid.Column="9" Grid.Row="0" />
      <Button Content="重置" Command="{Binding btn_MainMission_Clear}" Margin="10,3" FontSize="20" Style="{StaticResource CurrentButton}" Grid.Column="9" Grid.Row="1" />
      <Button Content="手动取消" Command="{Binding btn_MainMission_Cancel}" Margin="10,3" CommandParameter="{Binding ElementName=dgMission}" FontSize="20" Style="{StaticResource CurrentButton}" Visibility="{Binding Tag.用户权限.Button}" Grid.Column="8" Grid.Row="0" />
    </Grid>
    <!--  页码信息以及翻页功能  -->
    <Grid Margin="1" Background="#EBF5FF" Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="0.5*" />
        <ColumnDefinition Width="0.5*" />
        <ColumnDefinition Width="0.5*" />
        <ColumnDefinition Width="0.5*" />
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0">
        <Grid>
          <Label Content="{Binding Tag.任务管理.主任务管理.Page_Message}" HorizontalAlignment="Left" Style="{StaticResource CurrentLabel}" />
        </Grid>
      </Grid>
      <Grid Grid.Column="2">
        <Button Command="{Binding btn_MainMission_FirstPage}" Margin="10" FontSize="20" Style="{StaticResource CurrentButton}">
          首页
        </Button>
      </Grid>
      <Grid Grid.Column="3">
        <Button Command="{Binding btn_MainMission_PreviousPage}" Margin="10" FontSize="20" Style="{StaticResource CurrentButton}">
          上一页
        </Button>
      </Grid>
      <Grid Grid.Column="4">
        <Button Command="{Binding btn_MainMission_NextPage}" Margin="10" FontSize="20" Style="{StaticResource CurrentButton}">
          下一页
        </Button>
      </Grid>
      <Grid Grid.Column="5">
        <Button Command="{Binding btn_MainMission_LastPage}" Margin="10" FontSize="20" Style="{StaticResource CurrentButton}">
          尾页
        </Button>
      </Grid>
    </Grid>
    <!--  异常处理按钮  -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.25*" />
        <ColumnDefinition Width="0.25*" />
        <ColumnDefinition Width="0.25*" />
        <ColumnDefinition Width="1.25*" />
      </Grid.ColumnDefinitions>
      <!--<Button Content="打印出库单" Command="{Binding btn_Print}" Margin="10,3" CommandParameter="{Binding ElementName=dgMission}" FontSize="20" Style="{StaticResource CurrentButton}" Grid.Column="0" Grid.Row="0" />-->
      <!--<Button Content="强制完成"
              Margin="10,3"
              FontSize="20"
              Style="{StaticResource CurrentButton}"
              Grid.Column="1"
              Grid.Row="0" />
      <Button Content="异常取消"
              Margin="10,3"
              FontSize="20"
              Style="{StaticResource CurrentButton}"
              Grid.Column="2"
              Grid.Row="0" />-->
    </Grid>
  </Grid>
</Window>