<Window x:Class="GZ.Projects.WCS_Template.设备信号" x:Name="日志查询Window" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:GZ.Projects.WCS_HY" d:DesignHeight="450" d:DesignWidth="800" mc:Ignorable="d">
  <Window.Resources>
    <!--<WindowChrome x:Key="WindowChromeKey" CaptionHeight="0" GlassFrameThickness="0" NonClientFrameEdges="None" ResizeBorderThickness="0" UseAeroCaptionButtons="False" />-->
    <Style x:Key="HeaderButton" TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="Black" />
      <Setter Property="Background" Value="#007ACC" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="MinWidth" Value="130" />
      <Setter Property="Height" Value="50" />
      <Setter Property="BorderBrush" Value="LightGray" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Margin" Value=" 8" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <!--<Setter Property="Cursor" Value="Hand" />-->
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="0" />
      <RowDefinition />
      <RowDefinition Height="0" />
    </Grid.RowDefinitions>
    <Grid Margin="0" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="auto" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <WrapPanel Margin="5" Background="#EBF5FF" Orientation="Vertical" Grid.Column="0" Grid.Row="0" Grid.RowSpan="3">
        <Button Command="{Binding PLC监控}" Background="{Binding Path=Tag.UI.菜单按钮颜色.PLCTC01,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" CommandParameter="{Binding ElementName=系统管理Window}" Style="{StaticResource HeaderButton}">
          嘉远老厂1号堆垛机
        </Button>
        <Button Command="{Binding PLC监控2}" Background="{Binding Path=Tag.UI.菜单按钮颜色.PLCTC02,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" CommandParameter="{Binding ElementName=系统管理Window}" Style="{StaticResource HeaderButton}">
          B03车间2号堆垛机
        </Button>
        <Button Command="{Binding PLC监控3}" Background="{Binding Path=Tag.UI.菜单按钮颜色.PLCTC03,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" CommandParameter="{Binding ElementName=系统管理Window}" Style="{StaticResource HeaderButton}">
          B01车间3号堆垛机
        </Button>
        <Button Command="{Binding CV01}" Background="{Binding Path=Tag.UI.菜单按钮颜色.PLCCV01,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" CommandParameter="{Binding ElementName=系统管理Window}" Style="{StaticResource HeaderButton}">
          嘉远老厂输送线
        </Button>
        <Button Command="{Binding CV02}" Background="{Binding Path=Tag.UI.菜单按钮颜色.PLCCV02,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" CommandParameter="{Binding ElementName=系统管理Window}" Style="{StaticResource HeaderButton}">
          B03车间输送线
        </Button>
        <Button Command="{Binding CV03}" Background="{Binding Path=Tag.UI.菜单按钮颜色.PLCCV03,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" CommandParameter="{Binding ElementName=系统管理Window}" Style="{StaticResource HeaderButton}">
          B01车间输送线
        </Button>
        <Button Command="{Binding MEM}" Background="{Binding Path=Tag.UI.菜单按钮颜色.MEM,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" CommandParameter="{Binding ElementName=系统管理Window}" Style="{StaticResource HeaderButton}">
          内存记录
        </Button>
      </WrapPanel>
      <TabControl Name="tab" Background="#F0FFFF" Grid.Column="1" />
    </Grid>
  </Grid>
</Window>