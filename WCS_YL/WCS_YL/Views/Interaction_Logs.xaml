<Window x:Class="GZ.Projects.WCS_Template.Interaction_Logs" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:GZ.Projects.WCS_Template" d:DesignHeight="750" d:DesignWidth="1750" mc:Ignorable="d">
  <Window.Resources>
    <!--文本标签Label-->
    <Style x:Key="CurrentLabel" TargetType="{x:Type Label}">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <!--下拉框-->
    <Style x:Key="CurrentComboBox" TargetType="{x:Type ComboBox}">
      <Setter Property="MinWidth" Value="100" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="IsEditable" Value="True" />
      <Setter Property="IsTextSearchEnabled" Value="True" />
      <Setter Property="FontSize" Value="20" />
    </Style>
    <!--按钮-->
    <Style x:Key="CurrentButton" TargetType="{x:Type Button}">
      <Setter Property="Background" Value="#FF00796B" />
      <Setter Property="BorderBrush" Value="#FF00796B" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="20" />
    </Style>
    <!--文本框-->
    <Style x:Key="CurrentTextBox" TargetType="{x:Type TextBox}">
      <Setter Property="MinWidth" Value="100" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!--文本标签Label-->
    <Style x:Key="CurrentDatePicker" TargetType="{x:Type DatePicker}">
      <Setter Property="MinWidth" Value="150" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="18" />
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="0.7*" />
      <RowDefinition Height="0.6*" />
      <RowDefinition Height="7.5*" />
      <RowDefinition Height="0.8*" />
    </Grid.RowDefinitions>
    <Border BorderBrush="Gray" BorderThickness="1" Grid.Row="0">
      <Grid Background="#FFD0CCCC" Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.8*" />
          <ColumnDefinition Width="0.5*" />
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="4.5*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Margin="10" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="30" FontWeight="Bold" Grid.Column="0" Grid.Row="0">
          日志管理/日志查询
        </TextBlock>
        <TextBlock Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="20" Text="表名" Grid.Column="1" Grid.Row="0" />
        <ComboBox Margin="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="LightGreen" BorderThickness="1" DisplayMemberPath="DictValue" FontSize="20" ItemsSource="{Binding Tag.UI.日志查询.List_TableType}" SelectedValue="{Binding Tag.UI.日志查询.Text_TableType}" SelectedValuePath="DictName" Grid.Column="2" Grid.Row="0" />
        <!--<TextBlock Margin="5"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   FontSize="20"
                   Text="日志分类"
                   Grid.Column="3"
                   Grid.Row="0" />
        <ComboBox Margin="5"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  BorderBrush="LightGreen"
                  BorderThickness="1"
                  FontSize="20"
                  ItemsSource="{Binding Tag.UI.日志查询.List_LogType}"
                  SelectedValue="{Binding Tag.UI.日志查询.Text_LogType}"
                  Grid.Column="4"
                  Grid.Row="0" />-->
      </Grid>
    </Border>
    <!--异常处理按钮-->
    <!--搜索条件-->
    <Grid Background="LightGray" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.5*" />
        <ColumnDefinition />
        <ColumnDefinition Width="0" />
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="0.5*" />
        <ColumnDefinition Width="0.8*" />
        <ColumnDefinition Width="0.5*" />
        <ColumnDefinition Width="0.8*" />
        <ColumnDefinition Width="0.5*" />
        <ColumnDefinition Width="0.5*" />
        <ColumnDefinition Width="0.1*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition />
      </Grid.RowDefinitions>
      <TextBlock Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="20" Text="字段类型" Grid.Column="0" Grid.Row="0" />
      <ComboBox Margin="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="LightGreen" BorderThickness="1" DisplayMemberPath="DictValue" FontSize="20" ItemsSource="{Binding Tag.UI.日志查询.List_Field}" SelectedValue="{Binding Tag.UI.日志查询.Text_Field}" SelectedValuePath="DictName" Grid.Column="1" Grid.Row="0" />
      <TextBox Margin="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderBrush="LightGreen" BorderThickness="1" FontSize="20" Text="{Binding Tag.UI.日志查询.Text_QueryConditions}" Grid.Column="3" Grid.Row="0" />
      <TextBlock Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="20" Text="开始时间" Grid.Column="4" Grid.Row="0" />
      <DatePicker Margin="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="White" BorderBrush="LightGreen" BorderThickness="1" FontSize="20" SelectedDate="{Binding Tag.UI.日志查询.TXT_StartTime}" Style="{StaticResource CurrentDatePicker}" Grid.Column="5" Grid.Row="0" />
      <TextBlock Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="20" Text="结束时间" Grid.Column="6" Grid.Row="0" />
      <DatePicker Margin="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="White" BorderBrush="LightGreen" BorderThickness="1" FontSize="20" SelectedDate="{Binding Tag.UI.日志查询.TXT_EndTime}" Style="{StaticResource CurrentDatePicker}" Grid.Column="7" Grid.Row="0" />
      <Button Content="查询" Command="{Binding btn_Interaction_Logs_Select}" Margin="10,3" FontSize="20" Style="{StaticResource CurrentButton}" Grid.Column="8" Grid.Row="0" />
      <Button Content="重置" Command="{Binding btn_Interaction_Logs_Clear}" Margin="10,3" FontSize="20" Style="{StaticResource CurrentButton}" Grid.Column="9" Grid.Row="0" />
    </Grid>
    <!--数据展示列表-->
    <Grid Margin="3" Grid.Row="2">
      <!--数据表区：数据表-->
      <DataGrid x:Name="dgMission" Margin="0,0,0.4,0.4" HorizontalContentAlignment="Center" AlternationCount="2" AutoGenerateColumns="False" Background="#EBF5FF" CanUserAddRows="False" CanUserSortColumns="True" FontSize="20" ItemsSource="{Binding Tag.UI.日志查询.List_LintLogs,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Padding="5" SelectionUnit="Cell" Grid.ColumnSpan="2" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
        <DataGrid.ColumnHeaderStyle>
          <Style TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="2" />
          </Style>
        </DataGrid.ColumnHeaderStyle>
        <DataGrid.RowStyle>
          <Style TargetType="{x:Type DataGridRow}">
            <Style.Triggers>
              <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                <Setter Property="Background" Value="#F0FFFF" />
                <Setter Property="Height" Value="30" />
                <Setter Property="FontSize" Value="18" />
              </Trigger>
              <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                <Setter Property="Background" Value="White" />
                <Setter Property="Height" Value="30" />
                <Setter Property="FontSize" Value="18" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </DataGrid.RowStyle>
        <!--数据表：列-->
        <DataGrid.Columns>
          <DataGridTextColumn Width="120" Binding="{Binding SequenceId ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Header="序号" IsReadOnly="True" />
          <DataGridTextColumn Width="200" Binding="{Binding Title}" Header="日志标题">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="ToolTip" Value="{Binding Title}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Width="300" Binding="{Binding Message,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Header="日志内容">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="ToolTip" Value="{Binding Message}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Width="180" Binding="{Binding StartTime,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat='yyyy-MM-dd HH:mm:ss'}" Header="开始时间" IsReadOnly="True" />
          <DataGridTextColumn Width="180" Binding="{Binding EndTime,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat='yyyy-MM-dd HH:mm:ss'}" Header="结束时间" IsReadOnly="True" />
          <DataGridTextColumn Width="100" Binding="{Binding TimeSpan,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Header="持续时间(s)" IsReadOnly="True" />
          <DataGridTextColumn Width="120" Binding="{Binding Category,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Header="分类" IsReadOnly="True" />
          <DataGridTextColumn Width="120" Binding="{Binding User,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Header="用户名" IsReadOnly="True" />
          <DataGridTextColumn Width="100" Binding="{Binding Level,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Header="级别" IsReadOnly="True" />
          <DataGridTextColumn Width="250" Binding="{Binding CallSite,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Header="调用位置" IsReadOnly="True" />
          <DataGridTextColumn Width="80" Binding="{Binding LineNo,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Header="行号" IsReadOnly="True" />
          <DataGridTextColumn Width="150" Binding="{Binding Logger,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Header="日志类" IsReadOnly="True" />
          <DataGridTextColumn Width="150" Binding="{Binding MachineName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Header="计算机名" IsReadOnly="True" />
          <DataGridTextColumn Width="80" Binding="{Binding ProcessId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Header="进程ID" IsReadOnly="True" />
          <DataGridTextColumn Width="150" Binding="{Binding ProcessName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Header="进程名" IsReadOnly="True" />
          <!--
          <DataGridTextColumn Width="180" Binding="{Binding UtcTime,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat='yyyy-MM-dd HH:mm:ss'}" Header="UTC时间" IsReadOnly="True" />
          <DataGridTextColumn Width="180" Binding="{Binding LocalTime,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,StringFormat='yyyy-MM-dd HH:mm:ss'}" Header="本地时间" IsReadOnly="True" />
		  -->
          <DataGridTextColumn Width="150" Binding="{Binding Tags,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Header="标签">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="ToolTip" Value="{Binding Tags}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Width="200" Binding="{Binding Data,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Header="附加数据" IsReadOnly="True">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="ToolTip" Value="{Binding Data}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Width="150" Binding="{Binding LogicNo,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Header="业务编号" IsReadOnly="True" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
    <!--页码信息以及翻页功能-->
    <Grid Margin="1" Background="#EBF5FF" Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="0.5*" />
        <ColumnDefinition Width="0.5*" />
        <ColumnDefinition Width="0.5*" />
        <ColumnDefinition Width="0.5*" />
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0">
        <Grid>
          <Label Content="{Binding Tag.日志查询.Page_Message}" HorizontalAlignment="Left" Style="{StaticResource CurrentLabel}" />
        </Grid>
      </Grid>
      <Grid Grid.Column="2">
        <Button Command="{Binding btn_Interaction_Logs_First}" Margin="10" FontSize="20" Style="{StaticResource  CurrentButton}">
          首页
        </Button>
      </Grid>
      <Grid Grid.Column="3">
        <Button Command="{Binding btn_Interaction_Logs_Previous}" Margin="10" FontSize="20" Style="{StaticResource  CurrentButton}">
          上一页
        </Button>
      </Grid>
      <Grid Grid.Column="4">
        <Button Command="{Binding btn_Interaction_Logs_Next}" Margin="10" FontSize="20" Style="{StaticResource  CurrentButton}">
          下一页
        </Button>
      </Grid>
      <Grid Grid.Column="5">
        <Button Command="{Binding btn_Interaction_Logs_Last}" Margin="10" FontSize="20" Style="{StaticResource  CurrentButton}">
          尾页
        </Button>
      </Grid>
    </Grid>
  </Grid>
</Window>